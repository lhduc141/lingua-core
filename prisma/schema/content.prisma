model Lesson {
  lessonId String @id @default(dbgenerated("gen_random_uuid()")) @map("lesson_id") @db.Uuid

  skillName SkillName @map("skill_name")

  title       String
  description String?

  // Theory content (30%)
  // Structure: {sections: [{type: "rule"|"example"|"tip", content: "..."}]}
  theoryContent Json? @map("theory_content")

  status    ContentStatus @default(draft)
  cefrLevel String?       @map("cefr_level") // ← THÊM

  estimatedMinutes Int?  @map("estimated_minutes") // ← THÊM
  prerequisites    Json? // Array of lessonIds // ← THÊM

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lessonQuestions LessonQuestion[]
  questionSets    QuestionSet[]
  // exerciseRecords ExerciseRecord[] @relation("LessonExercises")

  @@index([skillName]) // ← THÊM
  @@index([cefrLevel]) // ← THÊM
  @@map("lessons")
}

model LessonQuestion {
  lessonId   String @map("lesson_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  position   Int

  lesson   Lesson   @relation(fields: [lessonId], references: [lessonId])
  question Question @relation(fields: [questionId], references: [questionId])

  @@id([lessonId, questionId])
  @@map("lesson_questions")
}
