model PracticeSession {
  sessionId String @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid

  title       String // "Writing Task 2 Practice"
  description String?
  skillName   SkillName
  cefrLevel   String?   @map("cefr_level") // Target level

  estimatedMinutes Int? @map("estimated_minutes")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  questions PracticeSessionQuestion[]

  @@index([skillName])
  @@index([cefrLevel])
  @@map("practice_sessions")
}

model PracticeSessionQuestion {
  sessionId  String @map("session_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  position   Int

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  session  PracticeSession @relation(fields: [sessionId], references: [sessionId])
  question Question        @relation(fields: [questionId], references: [questionId])

  @@id([sessionId, questionId])
  @@map("practice_session_questions")
}
