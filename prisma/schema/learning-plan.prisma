model LearningPlanItem {
  itemId String @id @default(dbgenerated("gen_random_uuid()")) @map("item_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  parentItemId String? @map("parent_item_id") @db.Uuid

  title    String
  itemType String? @map("item_type") // "lesson" | "practice_session" | "review"

  refType String? @map("ref_type") // "lesson" | "practice_session"
  refId   String? @map("ref_id") @db.Uuid

  dueDate  DateTime? @map("due_date") @db.Date
  position Int?

  status PlanItemStatus @default(pending)

  planCycle   Int?      @map("plan_cycle") // Cycle number (1, 2, 3...)
  generatedAt DateTime? @map("generated_at")

  description      String? @map("description") // Task instruction (custom_activity) hoặc Review JSON (weekly_review)
  rationale        String? @map("rationale") // AI giải thích tại sao chọn task này
  estimatedMinutes Int?    @map("estimated_minutes") // Thời gian ước tính
  skillName        String? @map("skill_name") // reading / writing / speaking
  weekNumber       Int?    @map("week_number") // 1 hoặc 2 (trong 2-week cycle)

  submittedText String?  @map("submitted_text") // User submission cho custom_activity
  taskScore     Decimal? @map("task_score") @db.Decimal(4, 2)

  userFeedback        String?   @map("user_feedback") // User nhận xét cho weekly review
  feedbackSubmittedAt DateTime? @map("feedback_submitted_at") // Gate: null = chưa feedback

  user           User               @relation(fields: [userId], references: [userId])
  parentItem     LearningPlanItem?  @relation("PlanItemParent", fields: [parentItemId], references: [itemId])
  children       LearningPlanItem[] @relation("PlanItemParent")
  sourceRecord   ExerciseRecord?    @relation(fields: [sourceRecordId], references: [exerciseRecordId])
  sourceRecordId String?            @map("source_record_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, planCycle])
  @@index([userId, planCycle, weekNumber])
  @@index([userId, itemType, status])
  @@map("learning_plan_items")
}
