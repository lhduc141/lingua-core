// Generic AI-call audit log used for reproducible experiments and production diagnostics.
// Stores the exact provider request/response plus provider-reported token usage.
model AiCallLog {
  aiCallLogId String       @id @default(dbgenerated("gen_random_uuid()")) @map("ai_call_log_id") @db.Uuid
  correlationId String?    @map("correlation_id") @db.Uuid
  feature       String
  stage         String
  provider      String       @default("groq")
  model         String
  status        AiCallStatus @default(pending)
  attemptIndex  Int          @default(0) @map("attempt_index")
  credentialSlot Int?        @map("credential_slot")

  requestPayload  Json  @map("request_payload")
  responsePayload Json? @map("response_payload")
  providerResponseId String? @map("provider_response_id")

  promptTokens       Int? @map("prompt_tokens")
  cachedPromptTokens Int? @map("cached_prompt_tokens")
  completionTokens   Int? @map("completion_tokens")
  reasoningTokens    Int? @map("reasoning_tokens")
  totalTokens        Int? @map("total_tokens")

  inputPricePerMillion       Decimal? @map("input_price_per_million") @db.Decimal(12, 6)
  cachedInputPricePerMillion Decimal? @map("cached_input_price_per_million") @db.Decimal(12, 6)
  outputPricePerMillion      Decimal? @map("output_price_per_million") @db.Decimal(12, 6)
  estimatedCostUsd           Decimal? @map("estimated_cost_usd") @db.Decimal(16, 10)

  queueTimeMs      Float? @map("queue_time_ms")
  promptTimeMs     Float? @map("prompt_time_ms")
  completionTimeMs Float? @map("completion_time_ms")
  totalTimeMs      Float? @map("total_time_ms")

  errorMessage String? @map("error_message")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([correlationId])
  @@index([feature, stage, createdAt])
  @@index([model, createdAt])
  @@map("ai_call_logs")
}
