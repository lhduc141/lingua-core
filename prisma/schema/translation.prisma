// TODO        TRANSLATION
model QuestionTranslation {
  questionId String @map("question_id") @db.Uuid
  locale     String

  stemText    String? @map("stem_text")
  explanation String?

  contentJson   Json? @map("content_json")
  schemaVersion Int?  @default(1) @map("schema_version")

  question Question @relation(fields: [questionId], references: [questionId])

  @@id([questionId, locale])
  @@map("question_translations")
}

model OptionTranslation {
  optionId    String  @map("option_id") @db.Uuid
  locale      String
  optionText  String? @map("option_text")
  explanation String?

  option QuestionOption @relation(fields: [optionId], references: [optionId])

  @@id([optionId, locale])
  @@map("option_translations")
}
