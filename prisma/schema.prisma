generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//TODO ===========================
//TODO            ENUM
//TODO ===========================

enum ContentStatus {
  draft     @map("draft")
  reviewed  @map("reviewed")
  published @map("published")
  archived  @map("archived")

  @@map("content_status")
}

enum QuestionType {
  // ========== OBJECTIVE (auto-graded) ==========
  mcq_single @map("mcq_single") // Chọn 1 đáp án
  mcq_multi  @map("mcq_multi") // Chọn nhiều đáp án
  fill_blank @map("fill_blank") // Điền từ (có đáp án cố định)
  matching   @map("matching") // Nối cặp
  ordering   @map("ordering") // Sắp xếp thứ tự
  cloze_bank @map("cloze_bank") // Chọn từ trong ngân hàng từ

  // ========== SUBJECTIVE (AI-graded) ==========
  short_answer @map("short_answer") // Viết ngắn (1-3 câu)
  translation  @map("translation") // Dịch câu
  essay        @map("essay") // ← THÊM TYPE MỚI (viết dài)
  speaking     @map("speaking") // ← THÊM TYPE MỚI (nói)
  dictation    @map("dictation") // Nghe viết

  @@map("question_type")
}

enum ExamKind {
  ielts   @map("ielts")
  toeic   @map("toeic")
  generic @map("generic")

  @@map("exam_kind")
}

enum ExamCycleKind {
  ielts_speaking @map("ielts_speaking")
  custom         @map("custom")

  @@map("exam_cycle_kind")
}

enum ExamCategory {
  ielts   @map("ielts")
  generic @map("generic")

  @@map("exam_category")
}

enum AssessmentRefType {
  exam             @map("exam")
  exam_section     @map("exam_section")
  lesson           @map("lesson")
  topic            @map("topic")
  placement_test   @map("placement_test")
  practice_session @map("practice_session")

  @@map("assessment_ref_type")
}

enum AssessmentStatus {
  draft       @map("draft")
  in_progress @map("in_progress")
  submitted   @map("submitted")
  scored      @map("scored")
  canceled    @map("canceled")

  @@map("assessment_status")
}

enum AttemptModality {
  reading   @map("reading")
  listening @map("listening")
  speaking  @map("speaking")
  writing   @map("writing")
  vocab     @map("vocab")
  grammar   @map("grammar")

  @@map("attempt_modality")
}

enum GradingStatus {
  pending        @map("pending")
  auto_scored    @map("auto_scored")
  human_reviewed @map("human_reviewed")

  @@map("grading_status")
}

enum AiCallStatus {
  pending @map("pending")
  success @map("success")
  error   @map("error")

  @@map("ai_call_status")
}

enum PlanItemStatus {
  pending     @map("pending")
  in_progress @map("in_progress")
  completed   @map("completed")
  skipped     @map("skipped")

  @@map("plan_item_status")
}

enum StudySessionStatus {
  planned     @map("planned")
  in_progress @map("in_progress")
  completed   @map("completed")
  canceled    @map("canceled")

  @@map("study_session_status")
}

enum NotificationChannel {
  email  @map("email")
  sms    @map("sms")
  push   @map("push")
  in_app @map("in_app")

  @@map("notification_channel")
}

enum NotificationStatus {
  scheduled @map("scheduled")
  sent      @map("sent")
  failed    @map("failed")
  canceled  @map("canceled")

  @@map("notification_status")
}

enum SrsCardType {
  dictionary @map("dictionary")
  custom     @map("custom")

  @@map("srs_card_type")
}

enum AssetKind {
  audio    @map("audio")
  image    @map("image")
  video    @map("video")
  document @map("document")

  @@map("asset_kind")
}

enum SkillName {
  reading  @map("reading")
  writing  @map("writing")
  speaking @map("speaking")

  @@map("skill_name")
}

// TODO ===========================
// TODO ====       AUTH
// TODO ===========================

// Google OAuth (5 fields)
// Personal Info (4 fields) ← merged
// Permissions (3 fields)
// Tokens (2 fields)
// Timestamps (3 fields)

model User {
  userId String @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid

  // ===== GOOGLE OAUTH
  email           String  @unique
  googleSub       String  @unique @map("google_sub")
  googleName      String? @map("google_name")
  googleAvatarUrl String? @map("google_avatar_url")

  // ===== PERSONAL INFO (merged from Profile)
  dob    DateTime? @db.Date
  gender String?
  phone  String?

  // ===== PERMISSIONS
  isAdmin     Boolean   @default(false) @map("is_admin")
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")

  // ===== REFRESH TOKEN
  currentRefreshTokenHash      String?   @map("current_refresh_token_hash")
  currentRefreshTokenExpiresAt DateTime? @map("current_refresh_token_expires_at")

  // ===== TIMESTAMPS
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ===== RELATIONS (giữ nguyên) =====
  attempts          Attempt[]
  assessments       Assessment[]
  availabilities    UserAvailability[]
  reports           AssessmentReport[]
  learningPlanItems LearningPlanItem[]
  studySessions     StudySession[]
  notifications     Notification[]
  srsCollections    SrsCollection[]
  srsCards          SrsCard[]
  onboardingSurvey  OnboardingSurvey?
  UserVocabulary    UserVocabulary[]

  @@map("users")
}

// TODO ===========================
// TODO        ONBOARDING
// TODO ===========================
model OnboardingSurvey {
  surveyId String @id @default(dbgenerated("gen_random_uuid()")) @map("survey_id") @db.Uuid
  userId   String @unique @map("user_id") @db.Uuid

  //? ============================================
  //? TIER 1: REQUIRED - AI BẮT BUỘC CẦN
  //? ============================================

  primaryGoal              String @map("primary_goal") // Mục tiêu chính (dropdown) - Values: 'communication' | 'work' | 'certification' | 'study_abroad' | 'travel' | 'other'
  plannedStudyHoursPerWeek Int    @map("planned_study_hours_per_week") // Thời gian học mỗi tuần (slider/input) - Min: 1, Max: 40, Recommended: 5-15
  primaryFocusSkills       Json   @map("primary_focus_skills") // Kỹ năng ưu tiên (multi-select) - Values: ["reading", "writing", "speaking", "listening"] hoặc ["all"]

  //? ============================================
  //? TIER 2: IMPORTANT - Giúp AI cá nhân hóa tốt hơn
  //? ============================================

  targetDeadlineDate DateTime? @map("target_deadline_date") @db.Date // Deadline mong muốn (date picker, optional)
  targetGoal         String?   @map("target_goal") // Chi tiết mục tiêu (conditional input) - Chỉ hiện nếu primaryGoal = 'certification' - Example: "IELTS 7.0", "TOEIC 850"
  selfAssessedLevel  String?   @map("self_assessed_level") // Tự đánh giá trình độ (dropdown) -  Values: 'beginner' | 'elementary' | 'intermediate' | 'advanced' - Note: User-friendly terms, không dùng CEFR
  usageContext       String?   @map("usage_context") // Ngữ cảnh sử dụng (dropdown) - Values: 'work_meetings' | 'work_emails' | 'academic' | 'casual' | 'travel' | 'exam_prep'
  difficulties       Json?     @map("difficulties") // Điểm khó khăn (multi-select) - Values: ["listening", "grammar", "vocabulary", "pronunciation", "writing", "speaking"]

  //? ============================================
  //? TIER 3: OPTIONAL - Context thêm
  //? ============================================

  additionalContext          String? @map("additional_context") // Thông tin thêm từ user (textarea, optional) - Max length: 500 chars - Placeholder: "Có điều gì khác bạn muốn chia sẻ? (tùy chọn)"
  yearsStudied               Int?    @map("years_studied") // Số năm đã học (dropdown, optional) - Values: null | 1 | 2 | 3 | 4 | 5+
  previousLearningExperience String? @map("previous_learning_experience") // Kinh nghiệm học trước đó (dropdown, optional) - Values: 'never' | 'school' | 'self_study' | 'classes' | 'online_courses'

  //? ============================================
  //? CERTIFICATION-SPECIFIC (conditional)
  //? ============================================

  targetCertification String? @map("target_certification") // Chỉ hiện nếu primaryGoal = 'certification' - Values: 'IELTS' | 'TOEIC' | 'TOEFL' | 'Cambridge' | 'other'
  targetScore         String? @map("target_score") // Điểm số mục tiêu (input, conditional) - Chỉ hiện nếu targetCertification có giá trị - Example: "7.0", "850", "100"

  // Timestamps
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  isActive Boolean @default(true) @map("is_active")

  // Relations
  user User @relation(fields: [userId], references: [userId])

  @@index([userId, createdAt(sort: Desc)])
  @@map("onboarding_surveys")
}

//TODO ===========================
//TODO   ASSESSMENT & PRACTICE
//TODO ===========================
model Assessment {
  assessmentId  String            @id @default(dbgenerated("gen_random_uuid()")) @map("assessment_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  refType       AssessmentRefType @map("ref_type")
  refId         String            @map("ref_id") @db.Uuid
  kind          String?
  status        AssessmentStatus  @default(draft)
  startedAt     DateTime?         @map("started_at")
  completedAt   DateTime?         @map("completed_at")
  score         Decimal?          @db.Decimal()
  displayLocale String?           @map("display_locale")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  user            User               @relation(fields: [userId], references: [userId])
  attempts        Attempt[]
  reports         AssessmentReport[]
  bandScores      BandScore[]
  sourcePlanItems LearningPlanItem[]

  // exam        Exam?        @relation("ExamAssessments", fields: [refId], references: [examId])
  // examSection ExamSection? @relation("ExamSectionAssessments", fields: [refId], references: [sectionId])
  // lesson      Lesson?      @relation("LessonAssessments", fields: [refId], references: [lessonId])
  @@map("assessments")
}

model Attempt {
  attemptId           String           @id @default(dbgenerated("gen_random_uuid()")) @map("attempt_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  assessmentId        String           @map("assessment_id") @db.Uuid
  questionId          String           @map("question_id") @db.Uuid
  sectionPosition     Int?             @map("section_position")
  modality            AttemptModality?
  submittedAt         DateTime?        @map("submitted_at")
  score               Decimal?         @db.Decimal()
  correct             Boolean?
  inputAssetId        String?          @map("input_asset_id") @db.Uuid
  transcriptAssetId   String?          @map("transcript_asset_id") @db.Uuid
  outputAssetId       String?          @map("output_asset_id") @db.Uuid
  gradingStatus       GradingStatus    @default(pending) @map("grading_status")
  manualOverrideScore Decimal?         @map("manual_override_score") @db.Decimal()
  raterId             String?          @map("rater_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  user        User                @relation(fields: [userId], references: [userId])
  assessment  Assessment          @relation(fields: [assessmentId], references: [assessmentId])
  question    Question            @relation(fields: [questionId], references: [questionId])
  answers     AttemptAnswer[]
  aiCalls     AttemptAiCall[]
  evaluations AttemptEvaluation[]

  inputAsset      Asset? @relation("InputAsset", fields: [inputAssetId], references: [assetId])
  transcriptAsset Asset? @relation("TranscriptAsset", fields: [transcriptAssetId], references: [assetId])
  outputAsset     Asset? @relation("OutputAsset", fields: [outputAssetId], references: [assetId])

  @@map("attempts")
}

model AttemptAnswer {
  attemptId     String    @map("attempt_id") @db.Uuid
  position      Int
  optionId      String?   @map("option_id") @db.Uuid
  textAnswer    String?   @map("text_answer")
  numericAnswer Decimal?  @map("numeric_answer") @db.Decimal()
  jsonAnswer    Json?     @map("json_answer")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  attempt Attempt         @relation(fields: [attemptId], references: [attemptId])
  option  QuestionOption? @relation(fields: [optionId], references: [optionId])

  @@id([attemptId, position])
  @@map("attempt_answers")
}

model Prompt {
  promptId      String    @id @default(dbgenerated("gen_random_uuid()")) @map("prompt_id") @db.Uuid
  name          String
  version       Int       @default(1)
  template      String
  variablesJson Json?     @map("variables_json")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  aiCalls AttemptAiCall[]

  @@map("prompts")
}

model AttemptAiCall {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId           String       @map("attempt_id") @db.Uuid
  provider            String?
  model               String?
  version             String?
  promptId            String?      @map("prompt_id") @db.Uuid
  systemPromptId      String?      @map("system_prompt_id") @db.Uuid
  inputHash           String?      @map("input_hash")
  status              AiCallStatus @default(pending)
  errorJson           Json?        @map("error_json")
  retriedOfCallId     String?      @map("retried_of_call_id") @db.Uuid
  promptTokens        Int?         @map("prompt_tokens")
  completionTokens    Int?         @map("completion_tokens")
  costUsd             Decimal?     @map("cost_usd") @db.Decimal()
  latencyMs           Int?         @map("latency_ms")
  guardrailFlags      Json?        @map("guardrail_flags")
  outputSchemaVersion Int?         @map("output_schema_version")
  temperature         Decimal?     @db.Decimal()
  seed                Int?
  toolCallsJson       Json?        @map("tool_calls_json")
  traceId             String?      @map("trace_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  deletedAt           DateTime?    @map("deleted_at")

  attempt Attempt @relation(fields: [attemptId], references: [attemptId])
  prompt  Prompt? @relation(fields: [promptId], references: [promptId])

  @@map("attempt_ai_calls")
}

model AttemptEvaluation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId     String    @map("attempt_id") @db.Uuid
  evalType      String?   @map("eval_type") // ai | human | hybrid
  framework     String? // ielts | cefr | custom
  criteriaJson  Json?     @map("criteria_json")
  overallScore  Decimal?  @map("overall_score") @db.Decimal()
  evidenceJson  Json?     @map("evidence_json")
  rubricVersion String?   @map("rubric_version")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  attempt    Attempt         @relation(fields: [attemptId], references: [attemptId])
  dimensions EvalDimension[]

  @@map("attempt_evaluations")
}

model EvalDimension {
  evalId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("eval_id") @db.Uuid
  attemptEvalId String    @map("attempt_eval_id") @db.Uuid
  name          String
  score         Decimal?  @db.Decimal()
  evidenceJson  Json?     @map("evidence_json")
  position      Int?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  attemptEvaluation AttemptEvaluation @relation(fields: [attemptEvalId], references: [id])

  @@map("eval_dimensions")
}

model Passage {
  passageId String @id @default(dbgenerated("gen_random_uuid()")) @map("passage_id") @db.Uuid

  title     String
  content   String  @db.Text // Reading text
  wordCount Int?    @map("word_count")
  cefrLevel String? @map("cefr_level") // A1-C2
  topic     String? // "education", "environment", "technology"
  sourceTag String? @map("source_tag") // "IELTS_2023", "custom"

  audioUrl String? @map("audio_url") // Optional audio version
  imageUrl String? @map("image_url") // Optional image

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  questions Question[]

  @@index([cefrLevel])
  @@index([topic])
  @@map("passages")
}

model PracticeSession {
  sessionId String @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid

  title       String // "Writing Task 2 Practice"
  description String?
  skillName   SkillName
  cefrLevel   String?   @map("cefr_level") // Target level

  estimatedMinutes Int? @map("estimated_minutes")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  questions PracticeSessionQuestion[]

  @@index([skillName])
  @@index([cefrLevel])
  @@map("practice_sessions")
}

model PracticeSessionQuestion {
  sessionId  String @map("session_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  position   Int

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  session  PracticeSession @relation(fields: [sessionId], references: [sessionId])
  question Question        @relation(fields: [questionId], references: [questionId])

  @@id([sessionId, questionId])
  @@map("practice_session_questions")
}

model Topic {
  topicId     String        @id @default(dbgenerated("gen_random_uuid()")) @map("topic_id") @db.Uuid
  levelHint   String?       @map("level_hint")
  status      ContentStatus @default(draft)
  authorId    String?       @map("author_id") @db.Uuid
  reviewerId  String?       @map("reviewer_id") @db.Uuid
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  lessons      Lesson[]
  translations TopicTranslation[]

  @@map("topics")
}

model Lesson {
  lessonId String @id @default(dbgenerated("gen_random_uuid()")) @map("lesson_id") @db.Uuid

  skillName SkillName
  topicId   String?   @map("topic_id") @db.Uuid // Keep for backward compat

  title       String // ← THÊM (từ translations?)
  description String? // ← THÊM

  // Theory content (30%)
  // Structure: {sections: [{type: "rule"|"example"|"tip", content: "..."}]}
  theoryContent Json? @map("theory_content") // ← THÊM

  version   Int           @default(1)
  status    ContentStatus @default(draft)
  cefrLevel String?       @map("cefr_level") // ← THÊM

  estimatedMinutes Int?  @map("estimated_minutes") // ← THÊM
  prerequisites    Json? // Array of lessonIds // ← THÊM

  authorId    String?   @map("author_id") @db.Uuid
  reviewerId  String?   @map("reviewer_id") @db.Uuid
  publishedAt DateTime? @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  topic           Topic?              @relation(fields: [topicId], references: [topicId])
  lessonQuestions LessonQuestion[]
  translations    LessonTranslation[]

  @@index([skillName]) // ← THÊM
  @@index([cefrLevel]) // ← THÊM
  @@map("lessons")
}

model Question {
  questionId String @id @default(dbgenerated("gen_random_uuid()")) @map("question_id") @db.Uuid

  passageId String? @map("passage_id") @db.Uuid // ← THÊM (for Reading)

  skill      String?
  type       QuestionType
  difficulty Int           @default(1)
  version    Int           @default(1)
  examKind   ExamKind      @default(generic) @map("exam_kind")
  status     ContentStatus @default(draft)

  authorId     String?   @map("author_id") @db.Uuid
  reviewerId   String?   @map("reviewer_id") @db.Uuid
  publishedAt  DateTime? @map("published_at")
  sourceTag    String?   @map("source_tag")
  timeLimitSec Int?      @map("time_limit_sec")
  maxScore     Int?      @default(1) @map("max_score")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  passage                  Passage?                  @relation(fields: [passageId], references: [passageId]) // ← THÊM
  options                  QuestionOption[]
  payload                  QuestionPayload?
  tags                     QuestionTag[]
  translations             QuestionTranslation[]
  lessonQuestions          LessonQuestion[]
  examSectionQuestions     ExamSectionQuestion[]
  practiceSessionQuestions PracticeSessionQuestion[] // ← THÊM
  attempts                 Attempt[]

  @@index([passageId]) // ← THÊM
  @@map("questions")
}

model LessonQuestion {
  lessonId   String @map("lesson_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  position   Int

  lesson   Lesson   @relation(fields: [lessonId], references: [lessonId])
  question Question @relation(fields: [questionId], references: [questionId])

  @@id([lessonId, questionId])
  @@map("lesson_questions")
}

model QuestionOption {
  optionId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("option_id") @db.Uuid
  questionId String    @map("question_id") @db.Uuid
  weight     Int?      @default(0)
  isCorrect  Boolean   @default(false) @map("is_correct")
  position   Int?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  question       Question            @relation(fields: [questionId], references: [questionId])
  translations   OptionTranslation[]
  attemptAnswers AttemptAnswer[]

  @@map("question_options")
}

model Asset {
  assetId String @id @default(dbgenerated("gen_random_uuid()")) @map("asset_id") @db.Uuid

  // XÓA ownerType, ownerId (polymorphic anti-pattern)

  kind     AssetKind // ← Type-safe enum
  url      String?
  mimeType String?   @map("mime_type")

  durationMs   Int?    @map("duration_ms")
  sizeBytes    Int?    @map("size_bytes")
  waveformJson Json?   @map("waveform_json")
  transcript   String?
  metaJson     Json?   @map("meta_json")
  checksum     String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Explicit relations thay vì polymorphic
  examSectionQuestions ExamSectionQuestion[] @relation("PassageAsset")
  assessmentReports    AssessmentReport[]    @relation("ExplanationAsset")
  attemptsInput        Attempt[]             @relation("InputAsset")
  attemptsTranscript   Attempt[]             @relation("TranscriptAsset")
  attemptsOutput       Attempt[]             @relation("OutputAsset")

  @@map("assets")
}

model QuestionPayload {
  questionId     String   @id @map("question_id") @db.Uuid
  schemaVersion  Int?     @default(1) @map("schema_version")
  configJson     Json?    @map("config_json")
  answerKeysJson Json?    @map("answer_keys_json")
  scoringJson    Json?    @map("scoring_json")
  validationJson Json?    @map("validation_json")
  updatedAt      DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [questionId])

  @@map("question_payloads")
}

model QuestionTag {
  questionId String @map("question_id") @db.Uuid
  tag        String

