{
	"name": "linguapanda-core",
	"version": "0.0.1",
	"description": "linguapanda thesis project",
	"author": "luuhoangduc",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build api-gateway",
		"format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
		"start": "nest start api-gateway",
		"start:dev": "nest start api-gateway --watch",
		"start-all": "node concurrently.js --start",
		"start-all:dev": "node concurrently.js --dev",
		"g:api": "nest g resource src/modules --no-crud --no-spec",
		"start:prod": "node dist/apps/api-gateway/main.js",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest"
	},
	"dependencies": {
		"@google/genai": "^1.32.0",
		"@google/generative-ai": "^0.24.1",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/microservices": "^11.1.9",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/sequelize": "^11.0.1",
		"@nestjs/swagger": "^11.2.3",
		"@prisma/adapter-pg": "^6.19.0",
		"@prisma/client": "^6.19.0",
		"argon2": "^0.44.0",
		"axios": "^1.13.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"compression": "^1.8.1",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"google-auth-library": "^10.5.0",
		"jsonwebtoken": "^9.0.2",
		"moment": "^2.30.1",
		"pg": "^8.16.3",
		"pg-hstore": "^2.3.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"sequelize": "^6.37.7",
		"sequelize-typescript": "^2.1.6",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.10.7",
		"@types/pg": "^8.15.6",
		"@types/supertest": "^6.0.2",
		"concurrently": "^9.2.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^30.0.0",
		"prettier": "^3.4.2",
		"prisma": "^6.19.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/apps/",
			"<rootDir>/libs/"
		],
		"moduleNameMapper": {
			"^@app/ai-client(|/.*)$": "<rootDir>/libs/ai-client/src/$1",
			"^@app/bullmq(|/.*)$": "<rootDir>/libs/bullmq/src/$1",
			"^@app/jwt(|/.*)$": "<rootDir>/libs/jwt/src/$1",
			"^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
		}
	}
}
